generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  OWNER
  CASHIER
  BUYER
}

enum PaymentMethod {
  EFECTIVO
  YAPE
  PLIN
  POS
  TRANSFERENCIA
}

enum SaleChannel {
  LOCAL
  PARA_LLEVAR
  DELIVERY
}

enum RecordStatus {
  ACTIVE
  CANCELLED
}

enum CashStatus {
  OPEN
  CLOSED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(CASHIER)
  isActive     Boolean  @default(true)

  createdPurchases      Purchase[] @relation("PurchaseCreatedBy")
  cancelledPurchases    Purchase[] @relation("PurchaseCancelledBy")
  createdSales          Sale[]     @relation("SaleCreatedBy")
  cancelledSales        Sale[]     @relation("SaleCancelledBy")
  createdExpenses       Expense[]  @relation("ExpenseCreatedBy")
  cancelledExpenses     Expense[]  @relation("ExpenseCancelledBy")
  openedCashSessions    CashSession[] @relation("CashOpenedBy")
  closedCashSessions    CashSession[] @relation("CashClosedBy")
  createdCashSessions   CashSession[] @relation("CashCreatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PurchaseCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)

  products  PurchaseProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PurchaseProduct {
  id         String  @id @default(uuid())
  categoryId String
  name       String
  unit       String
  isActive   Boolean @default(true)

  category PurchaseCategory @relation(fields: [categoryId], references: [id])
  items    PurchaseItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Supplier {
  id       String  @id @default(uuid())
  name     String
  phone    String?
  address  String?
  notes    String?
  isActive Boolean @default(true)

  purchases Purchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Purchase {
  id            String        @id @default(uuid())
  supplierId    String?
  purchaseDate  DateTime
  paymentMethod PaymentMethod
  totalAmount   Decimal       @db.Decimal(10, 2)
  notes         String?
  status        RecordStatus  @default(ACTIVE)

  cancelledAt   DateTime?
  cancelledById String?
  cancelReason  String?

  createdById String?

  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  items       PurchaseItem[]
  createdBy   User?     @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  cancelledBy User?     @relation("PurchaseCancelledBy", fields: [cancelledById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purchaseDate])
  @@index([status])
}

model PurchaseItem {
  id         String  @id @default(uuid())
  purchaseId String
  productId  String
  quantity   Decimal @db.Decimal(10, 2)
  unitPrice  Decimal @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(10, 2)

  purchase Purchase        @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  PurchaseProduct @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
}

model SaleProduct {
  id           String  @id @default(uuid())
  name         String
  defaultPrice Decimal @db.Decimal(10, 2)
  category     String?
  isActive     Boolean @default(true)

  items SaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Sale {
  id            String        @id @default(uuid())
  saleDate      DateTime
  paymentMethod PaymentMethod
  channel       SaleChannel
  totalAmount   Decimal       @db.Decimal(10, 2)
  notes         String?
  status        RecordStatus  @default(ACTIVE)

  cancelledAt   DateTime?
  cancelledById String?
  cancelReason  String?

  createdById String?

  items       SaleItem[]
  createdBy   User? @relation("SaleCreatedBy", fields: [createdById], references: [id])
  cancelledBy User? @relation("SaleCancelledBy", fields: [cancelledById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([saleDate])
  @@index([status])
}

model SaleItem {
  id            String  @id @default(uuid())
  saleId        String
  saleProductId String
  quantity      Decimal @db.Decimal(10, 2)
  unitPrice     Decimal @db.Decimal(10, 2)
  totalPrice    Decimal @db.Decimal(10, 2)

  sale        Sale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleProduct SaleProduct @relation(fields: [saleProductId], references: [id])

  createdAt DateTime @default(now())
}

model ExpenseCategory {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  expenses Expense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Expense {
  id                String        @id @default(uuid())
  expenseCategoryId String
  expenseDate       DateTime
  paymentMethod     PaymentMethod
  amount            Decimal       @db.Decimal(10, 2)
  description       String?
  status            RecordStatus  @default(ACTIVE)

  cancelledAt   DateTime?
  cancelledById String?
  cancelReason  String?

  createdById String?

  category    ExpenseCategory @relation(fields: [expenseCategoryId], references: [id])
  createdBy   User?           @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  cancelledBy User?           @relation("ExpenseCancelledBy", fields: [cancelledById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expenseDate])
  @@index([status])
}

model CashSession {
  id            String     @id @default(uuid())
  openingDate   DateTime
  closingDate   DateTime?
  openingAmount Decimal    @db.Decimal(10, 2)
  expectedAmount Decimal?  @db.Decimal(10, 2)
  realAmount    Decimal?   @db.Decimal(10, 2)
  difference    Decimal?   @db.Decimal(10, 2)
  status        CashStatus @default(OPEN)
  notes         String?

  openedById String?
  closedById String?
  createdById String?

  openedBy  User? @relation("CashOpenedBy", fields: [openedById], references: [id])
  closedBy  User? @relation("CashClosedBy", fields: [closedById], references: [id])
  createdBy User? @relation("CashCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([openingDate])
}
